#!/bin/zsh

export CLICOLOR=1
export LSCOLORS=gxbxdxexfxabacadaeafag

# An inherited FPATH can replace zsh's standard autoload directories.
if [[ -d "/usr/share/zsh/${ZSH_VERSION}/functions" ]]; then
  fpath=("/usr/share/zsh/${ZSH_VERSION}/functions" $fpath)
fi

# Use bright white for default text (helps with VS Code terminal appearing grey)
export TERM="xterm-256color"
autoload -U colors && colors
echo -ne "\033[97m"


### Generic Config

autoload -Uz add-zsh-hook

# Resolve the sourced file so the functions load through the ~/.zshrc symlink.
fpath=("${${(%):-%x}:A:h}/functions" $fpath)
autoload -Uz _tmux_session_name _tmux_goto_session
autoload -Uz tmux-dir tmux-code


### Host Config

# Per-machine values, generated into ~/.dotfiles-config by hosts/macos_setup.sh.
# Sourced before Homebrew below, which consumes DOTFILES_CONFIG[brew_prefix].
if [[ -r "$HOME/.dotfiles-config" ]]; then
  source "$HOME/.dotfiles-config"
else
  print -u2 "! No ~/.dotfiles-config. Run macos_setup.sh from the dotfiles repo."
fi

# Read a host config value, or explain what is missing and fail.
host_config() {
  local key="$1"
  if (( ! ${+DOTFILES_CONFIG} )); then
    print -u2 "! No host config loaded. Run macos_setup.sh from the dotfiles repo."
    return 1
  fi
  if [[ -z "${DOTFILES_CONFIG[$key]}" ]]; then
    print -u2 "! Host config has no '$key'. Re-run macos_setup.sh to set it."
    return 1
  fi
  print -r -- "${DOTFILES_CONFIG[$key]}"
}


vsc() {
  # Open VS Code in a new window
  code -n "${1:-.}"

  # Give VS Code time to launch and focus
  sleep 0.5

  osascript <<EOF
tell application "System Events"
  tell process "Code"
    -- ⌃⌥⌘S
    key code 1 using {control down, option down, command down}
    delay 0.1

    -- ⌃⌥⌘D
    key code 2 using {control down, option down, command down}
    delay 0.1

    -- ⌃⌥↑
    key code 126 using {control down, option down}
  end tell
end tell
EOF
}

ps1() {
    # Using bright/bold 256-color codes for better visibility
    # 10=bright green, 12=bright blue, 13=bright magenta, 11=bright yellow, 9=bright red, 14=bright cyan, 15=bright white
    local ps1_string="%F{10}%1~%f %F{12}>%f "
    local precmd_funcs=()

    local prefix=""
    for param in "$@"; do
        if [[ "$param" == "git" ]]; then
            prefix+='%F{13}[%B$(git_repo_name 2>/dev/null || printf -- "-")%b|$(git-branch-name 2>/dev/null || printf -- "-")|$(git_status_check 2>/dev/null || printf -- "-")]%f '
        fi

        if [[ "$param" == "k8s" ]]; then
            prefix+='%F{11}[$(kubectl config current-context 2>/dev/null || echo "-")|$(ns=$(kubectl config view --minify -o "jsonpath={..namespace}" 2>/dev/null); echo "${ns:-default}")]%f '
        fi

        if [[ "$param" == "date" ]]; then
            prefix+='%F{9}%D{%a %b %d}%f '
        fi

        if [[ "$param" == "host" ]]; then
            prefix+='%F{14}%m%f '
        fi

        if [[ "$param" == "bao" ]]; then
            prefix+='%F{208}[${BAO_INSTANCE:--}]%f '
        fi

        if [[ "$param" == "venv" ]]; then
            prefix+='%(1V.%F{15}(%1v)%f .)'
            precmd_funcs+=(_update_venv)
        fi
    done
    ps1_string="${prefix}${ps1_string}"

    if [[ "$#" -ne 0 ]]; then
        setopt PROMPT_SUBST
        export PS1="$ps1_string"

        # Set up precmd hooks for dynamic updates
        if (( ${#precmd_funcs[@]} > 0 )); then
            for func in "${precmd_funcs[@]}"; do
                add-zsh-hook precmd $func
            done
        fi
    else
        echo "git, k8s, date, host, bao, venv"
    fi
}

_update_venv() {
    if [[ -n "$VIRTUAL_ENV" ]]; then
        psvar[1]=$(basename "$VIRTUAL_ENV")
    else
        psvar[1]=''
    fi
}


### Homebrew

# Not host_config: if the host config is missing, brew still has to come up, or
# there is no way to run the setup that would fix it. Bootstrap escape hatch, not a default.
_brew_prefix="${DOTFILES_CONFIG[brew_prefix]:-/opt/homebrew}"
if [[ -x "$_brew_prefix/bin/brew" ]]; then
  eval "$("$_brew_prefix/bin/brew" shellenv)"
  export PATH="$_brew_prefix/opt/ruby/bin:$PATH"
else
  print -u2 "! No brew at $_brew_prefix. Re-run macos_setup.sh to fix brew_prefix."
fi
unset _brew_prefix


### Git and Linting

alias git-branch-name='git rev-parse --abbrev-ref HEAD'
alias git-publish-nolint='git push origin $(git-branch-name)'

git_repo_name() {
    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    printf "%s" "${repo_root:t}"
}

git_status_check() {
    if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
        printf "*"
        return 0
    fi
    if git rev-parse --verify origin/$(git branch --show-current) &>/dev/null && [[ -n "$(git log origin/$(git branch --show-current)..HEAD 2>/dev/null)" ]]; then
        printf "!"
        return 0
    fi
    printf "-"
    return 0
}


lint() {
    local has_error=0

    if ! command -v tofu &> /dev/null; then
        echo "- Opentofu not found.  Skipping Opentofu linting."
    else
        echo "+ Checking Opentofu"
        if ! tofu fmt -check -recursive; then
            has_error=1
        fi
    fi

    if [[ -n $VIRTUAL_ENV ]]; then
        echo "+ Virtual Env Found.  Checking Python via Black"
        if ! black --check .; then
            has_error=1
        fi
    elif command -v black &> /dev/null; then
        echo "+ Checking Python via Black"
        if ! black --check .; then
            has_error=1
        fi
    else
        echo "- No Virtual Env or Black Found.  Skipping Python linting."
    fi

    if ! command -v golangci-lint &> /dev/null; then
        echo "- Golangci-lint not found.  Skipping golang linting."
    else
        echo "+ Checking Golang"
        local repo_root=$(git rev-parse --show-toplevel)
        echo "+ - Starting golangci-lint in directory: $repo_root"
        for file in "$repo_root"/*; do
            if [[ -d "$file" ]]; then
                for subfile in "$file"/*; do
                    if [[ -f "$subfile" ]] && [[ "$(basename "$subfile")" == "main.go" ]]; then
                        echo "+ - Go Directory: $file"
                        pushd "$file" > /dev/null || return 1
                        if ! golangci-lint run -E bodyclose --timeout 5m0s; then
                            has_error=1
                        fi
                        popd > /dev/null || return 1
                        break
                    fi
                done
            fi
        done
    fi

    if ! command -v shellcheck &> /dev/null; then
        echo "- Shellcheck not found.  Skipping shell linting."
    else
        echo "+ Checking Shell"
        if ! find . -not -path '*/.git/*' -type f -exec grep -Eq '^#!(.*/|.*env +)(sh|bash|ksh)' {} \; -exec shellcheck {} +; then
            has_error=1
        fi
    fi

    return $has_error
}

alias git-publish='git_publish'
git_publish() {
    if ! lint; then
        echo ":( Linting failed.  Not publishing."
        return 1
    fi

    echo ":) Linting passed.  Publishing."
    echo "   --    ____"
    echo "  ---  /|_||_\`.__"
    echo "   -- (   _    _ _\\"
    git-publish-nolint
}


### Kubernetes

K8S_CONFIGS="$HOME/.kube/configs"
alias k='kubectl'
alias k-setns='kubectl config set-context --current --namespace'
k-setcontext() {
    local configs=("$K8S_CONFIGS"/*.yaml(N))
    if (( ${#configs[@]} == 0 )); then
        echo "No kubeconfig files found in $K8S_CONFIGS" >&2
        return 1
    fi
    local names=()
    local c
    for c in "${configs[@]}"; do names+=("$(basename "$c")"); done
    local PS3="Select kubeconfig: "
    local choice
    select choice in "${names[@]}"; do
        if [[ -n "$choice" ]]; then
            export KUBECONFIG="$K8S_CONFIGS/$choice"
            echo "KUBECONFIG=$KUBECONFIG"
            break
        fi
    done
}
k-orb()  { export KUBECONFIG="$K8S_CONFIGS/orbstack.yaml";  kubectl "$@"; }
k-dev()  { export KUBECONFIG="$K8S_CONFIGS/dev.yaml";  kubectl "$@"; }
k-prod() { export KUBECONFIG="$K8S_CONFIGS/prod.yaml"; kubectl "$@"; }


