emulate -L zsh

local session_name="$1"

if [[ -z "$session_name" ]]; then
  echo "_tmux_reset_session: session name required" >&2
  return 1
fi

if ! tmux has-session -t "=${session_name}" 2>/dev/null; then
  return 0
fi

local current_session=""
if [[ -n "$TMUX" ]]; then
  current_session="$(tmux display-message -p '#S' 2>/dev/null)"
fi

# Killing the session this client is on would drop the client before the
# replacement exists, so rename it out of the way instead and print the stashed
# name. The caller kills it once it has switched to the fresh session.
if [[ "$current_session" == "$session_name" ]]; then
  local stashed="${session_name}-old-$$"
  tmux rename-session -t "=${session_name}" "$stashed" || return 1
  print -r -- "$stashed"
  return 0
fi

tmux kill-session -t "=${session_name}" || return 1
