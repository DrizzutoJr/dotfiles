emulate -L zsh

if ! command -v tmux &> /dev/null; then
  echo "tmux not found" >&2
  return 1
fi

local reset=0
local arg
for arg in "$@"; do
  case "$arg" in
    -n|--new) reset=1 ;;
    *)
      echo "tmux-dir: unknown option: $arg" >&2
      return 1
      ;;
  esac
done

local session_name
session_name="$(_tmux_session_name dir)" || return 1

local stashed=""
if (( reset )); then
  stashed="$(_tmux_reset_session "$session_name")" || return 1
fi

local pane announce
if ! tmux has-session -t "=${session_name}" 2>/dev/null; then
  pane="$(tmux new-session -d -s "$session_name" -c "$PWD" -P -F '#{pane_id}')" || return 1
  announce="!!! New session ${session_name} started at $(date '+%Y-%m-%d %H:%M:%S') !!!"

  if ! tmux send-keys -t "$pane" "echo ${(qq)announce}" Enter; then
    tmux kill-session -t "=${session_name}" >/dev/null 2>&1
    if [[ -n "$stashed" ]]; then
      tmux rename-session -t "=${stashed}" "$session_name" >/dev/null 2>&1
    fi
    return 1
  fi
fi

_tmux_goto_session "$session_name" || return 1

if [[ -n "$stashed" ]]; then
  tmux kill-session -t "=${stashed}" >/dev/null 2>&1
fi
