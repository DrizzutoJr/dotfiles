emulate -L zsh

local session_name="$1"

if [[ -z "$session_name" ]]; then
  echo "_tmux_goto_session: session name required" >&2
  return 1
fi

local pane_tty=""
if [[ -n "$TMUX" && -n "$TMUX_PANE" ]]; then
  pane_tty="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null)" || pane_tty=""
fi

if [[ -n "$pane_tty" && "$pane_tty" == "$(tty 2>/dev/null)" ]]; then
  tmux switch-client -t "=${session_name}"
else
  local -a tmux_command=(tmux)
  if [[ -n "$TMUX" ]]; then
    tmux_command+=(-S "${TMUX%%,*}")
  fi
  (
    unset TMUX TMUX_PANE
    "${tmux_command[@]}" attach-session -t "=${session_name}"
  )
fi
