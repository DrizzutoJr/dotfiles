### Generic Config

autoload -Uz add-zsh-hook

ps1() {
    # Using bright/bold 256-color codes for better visibility
    # 10=bright green, 12=bright blue, 13=bright magenta, 11=bright yellow, 9=bright red, 14=bright cyan, 15=bright white
    local ps1_string="%F{10}%1~%f %F{12}>%f "
    local precmd_funcs=()

    local prefix=""
    for param in "$@"; do
        if [[ "$param" == "git" ]]; then
            prefix+='%F{13}[$(git-branch-name 2>/dev/null || echo "-")|$(git_status_check 2>/dev/null || echo "-")]%f '
        fi

        if [[ "$param" == "k8s" ]]; then
            prefix+='%F{11}[$(kubectl config current-context 2>/dev/null || echo "-")|$(ns=$(kubectl config view --minify -o "jsonpath={..namespace}" 2>/dev/null); echo "${ns:-default}")]%f '
        fi

        if [[ "$param" == "date" ]]; then
            prefix+='%F{9}%D{%a %b %d}%f '
        fi

        if [[ "$param" == "host" ]]; then
            prefix+='%F{14}%m%f '
        fi

        if [[ "$param" == "venv" ]]; then
            prefix+='%(1V.%F{15}(%1v)%f .)'
            precmd_funcs+=(_update_venv)
        fi
    done
    ps1_string="${prefix}${ps1_string}"

    if [[ "$#" -ne 0 ]]; then
        setopt PROMPT_SUBST
        export PS1="$ps1_string"

        # Set up precmd hooks for dynamic updates
        if (( ${#precmd_funcs[@]} > 0 )); then
            for func in "${precmd_funcs[@]}"; do
                add-zsh-hook precmd $func
            done
        fi
    else
        echo "git, k8s, date, host, venv"
    fi
}

_update_venv() {
    if [[ -n "$VIRTUAL_ENV" ]]; then
        psvar[1]=$(basename "$VIRTUAL_ENV")
    else
        psvar[1]=''
    fi
}


