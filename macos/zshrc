### Git and Linting

alias git-branch-name='git rev-parse --abbrev-ref HEAD'
alias git-publish-nolint='git push origin $(git-branch-name)'

git_status_check() {
    if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
        printf "*"
        return 0
    fi
    if git rev-parse --verify origin/$(git branch --show-current) &>/dev/null && [[ -n "$(git log origin/$(git branch --show-current)..HEAD 2>/dev/null)" ]]; then
        printf "!"
        return 0
    fi
    printf "-"
    return 0
}


lint() {
    local has_error=0

    if ! command -v tofu &> /dev/null; then
        echo "- Opentofu not found.  Skipping Opentofu linting."
    else
        echo "+ Checking Opentofu"
        if ! tofu fmt -check -recursive; then
            has_error=1
        fi
    fi

    if [[ -n $VIRTUAL_ENV ]]; then
        echo "+ Virtual Env Found.  Checking Python via Black"
        if ! black --check .; then
            has_error=1
        fi
    elif command -v black &> /dev/null; then
        echo "+ Checking Python via Black"
        if ! black --check .; then
            has_error=1
        fi
    else
        echo "- No Virtual Env or Black Found.  Skipping Python linting."
    fi

    if ! command -v golangci-lint &> /dev/null; then
        echo "- Golangci-lint not found.  Skipping golang linting."
    else
        echo "+ Checking Golang"
        local repo_root=$(git rev-parse --show-toplevel)
        echo "+ - Starting golangci-lint in directory: $repo_root"
        for file in "$repo_root"/*; do
            if [[ -d "$file" ]]; then
                for subfile in "$file"/*; do
                    if [[ -f "$subfile" ]] && [[ "$(basename "$subfile")" == "main.go" ]]; then
                        echo "+ - Go Directory: $file"
                        pushd "$file" > /dev/null || return 1
                        if ! golangci-lint run -E bodyclose --timeout 5m0s; then
                            has_error=1
                        fi
                        popd > /dev/null || return 1
                        break
                    fi
                done
            fi
        done
    fi

    if ! command -v shellcheck &> /dev/null; then
        echo "- Shellcheck not found.  Skipping shell linting."
    else
        echo "+ Checking Shell"
        if ! find . -not -path '*/.git/*' -type f -exec grep -Eq '^#!(.*/|.*env +)(sh|bash|ksh)' {} \; -exec shellcheck {} +; then
            has_error=1
        fi
    fi

    return $has_error
}

alias git-publish='git_publish'
git_publish() {
    if ! lint; then
        echo ":( Linting failed.  Not publishing."
        return 1
    fi

    echo ":) Linting passed.  Publishing."
    echo "   --    ____"
    echo "  ---  /|_||_\`.__"
    echo "   -- (   _    _ _\\"
    git-publish-nolint
}


