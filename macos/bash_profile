### Generic Config

ps1(){
    if [ "$1" == "git" ]
    then
        export PS1="\[\e[95m\][\$(git-branch-name 2>/dev/null || echo '-')\e[38;5;230m\] | \e[95m\]\$(git_status_check 2>/dev/null || echo '-')] \[\e[0m\]\[\e[32m\]\W\[\e[0m\] \[\e[96m\]> \[\e[0m\]"
    elif [ "$1" == "k8s" ]
    then
        export PS1="\[\e[93m\][\$(kubectl config current-context 2>/dev/null || echo '-')\e[38;5;230m\] | \e[93m\]\$(kubectl config view --minify --output 'jsonpath={..namespace}' 2>/dev/null || echo '-')] \[\e[0m\]\[\e[32m\]\W\[\e[0m\] \[\e[96m\]> \[\e[0m\]"
    else
        export PS1="\[\e[91m\] \[\e[0m\]\[\e[91m\]\d\[\e[0m\] \[\e[32m\]\W\[\e[0m\] \[\e[96m\]> \[\e[0m\]"
    fi
}
ps1 generic
echo "ᕦ (ò_ó *) ᕤ"


### Homebrew

