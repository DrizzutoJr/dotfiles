### Git and Linting

alias git-branch-name='git rev-parse --abbrev-ref HEAD'
alias git-publish-nolint='git push origin $(git-branch-name)'
alias git-ps1='git_ps1'

git_status_check() {
    if [ -n "$(git status --porcelain 2>/dev/null)" ]
    then
        echo -n "*"
        return 0
    fi
    if [ -n "$(git log origin/$(git branch --show-current)..HEAD)" ]
    then
        echo -n "!"
        return 0
    fi
    return 1
}


lint() {
    has_error=0

    if ! command -v terraform &> /dev/null; then
        echo "- Terraform not found.  Skipping terraform linting."
    else
        echo "+ Checking Terraform"
        terraform fmt -check -recursive
        if [ $? -ne 0 ]; then
            has_error=1
        fi
    fi

    if ! command -v tofu &> /dev/null; then
        echo "- Opentofu not found.  Skipping Opentofu linting."
    else
        echo "+ Checking Opentofu"
        tofu fmt -check -recursive
        if [ $? -ne 0 ]; then
            has_error=1
        fi
    fi

    if [[ -n $VIRTUAL_ENV ]]; then
        echo "+ Virtual Env Found.  Checking Python via Black"
        black --check .
        if [ $? -ne 0 ]; then
            has_error=1
        fi
    elif command -v black &> /dev/null; then
        echo "+ Checking Python via Black"
        black --check .
        if [ $? -ne 0 ]; then
            has_error=1
        fi
    else
        echo "- No Virtual Env or Black Found.  Skipping Python linting."
    fi

    if ! command -v golangci-lint &> /dev/null; then
        echo "- Golangci-lint not found.  Skipping golang linting."
    else
        echo "+ Checking Golang"
        for file in ./*; do
            if [ -d "$file" ]; then
                for subfile in "$file"/*; do
                    if [ -f "$subfile" ] && [[ "$(basename "$subfile")" == "main.go" ]]; then
                        echo "+ - Running golangci-lint in directory: $file"
                        pushd "$file" > /dev/null
                        golangci-lint run -E bodyclose --timeout 5m0s
                        if [ $? -ne 0 ]; then
                            has_error=1
                        fi
                        popd > /dev/null
                        break
                    fi
                done
            fi
        done
    fi

    if ! command -v shellcheck &> /dev/null; then
        echo "- Shellcheck not found.  Skipping shell linting."
    else
        echo "+ Checking Shell"
        find "${1:-.}" -not -path '*/.git/*' -type f -exec grep -Eq '^#!(.*/|.*env +)(sh|bash|ksh)' {} \; -exec shellcheck {} +
        if [ $? -ne 0 ]; then
            has_error=1
        fi
    fi

    return $has_error
}

git_publish() {
    if ! lint; then
        echo ":( Linting failed.  Not publishing."
        return 1
    fi

    echo ":) Linting passed.  Publishing."
    echo "   --    ____"
    echo "  ---  /|_||_\`.__"
    echo "   -- (   _    _ _\\"
    git-publish-nolint
}

alias git-publish='git_publish'

